	"item": [
		{
			"name": "Scenario 1: Website Enquiry - New Customer",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response indicates new customer and success\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    pm.expect(jsonData.isNewCustomer).to.eql(true);",
							"    pm.expect(jsonData.enquiryId).to.be.a('string');",
							"    pm.expect(jsonData.contactId).to.be.a('string');",
							"    pm.collectionVariables.set(\"enquiry_id\", jsonData.enquiryId);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"customerName\": \"Rohan Mehra {{$timestamp}}\",\n    \"customerEmail\": \"rohan.mehra.{{$timestamp}}@example.com\",\n    \"customerPhone\": \"9876543210\",\n    \"productName\": \"SparkNest Solar Inverter 5kVA\",\n    \"enquiryType\": \"Product Enquiry\"\n}",
					"options": {
