		{
			"name": "Scenario 4: Composite API - B2B Onboarding (Success)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Both Contact and Enquiry subrequests created (201)\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.compositeResponse).to.be.an('array').with.lengthOf(2);",
							"    pm.expect(jsonData.compositeResponse[0].httpStatusCode).to.eql(201);",
							"    pm.expect(jsonData.compositeResponse[1].httpStatusCode).to.eql(201);",
							"    pm.expect(jsonData.compositeResponse[0].referenceId).to.eql(\"NewContactRef\");",
							"    pm.expect(jsonData.compositeResponse[1].referenceId).to.eql(\"NewEnquiryRef\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"allOrNone\": true,\n    \"compositeRequest\": [\n        {\n            \"method\": \"POST\",\n            \"url\": \"/services/data/v68.0/sobjects/Contact\",\n            \"referenceId\": \"NewContactRef\",\n            \"body\": {\n                \"FirstName\": \"Anand\",\n                \"LastName\": \"Verma {{$timestamp}}\",\n                \"Email\": \"anand.verma.{{$timestamp}}@sparknestenergy.com\",\n                \"Phone\": \"9123456780\"\n            }\n        },\n        {\n            \"method\": \"POST\",\n            \"url\": \"/services/data/v68.0/sobjects/Enquiry__c\",\n            \"referenceId\": \"NewEnquiryRef\",\n            \"body\": {\n                \"Subject__c\": \"B2B Commercial Solar Setup\",\n                \"Contact__c\": \"@{NewContactRef.id}\",\n                \"Enquiry_Type__c\": \"Product Enquiry\",\n                \"Source__c\": \"Web\",\n                \"Customer_Budget__c\": 50000\n            }\n        }\n    ]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{instance_url}}/services/data/v68.0/composite",
					"host": [
						"{{instance_url}}"
					],
					"path": [
						"services",
						"data",
						"v68.0",
						"composite"
					]
				}
			},
			"response": []
		},
		{
			"name": "Scenario 5: Composite API - Rollback on Invalid Budget",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 400\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
							"});",
							"",
							"pm.test(\"Composite subrequests failed with rollback (400)\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.compositeResponse).to.be.an('array');",
							"    var enquiryResp = jsonData.compositeResponse.find(r => r.referenceId === \"RollbackEnquiryRef\");",
							"    pm.expect(enquiryResp.httpStatusCode).to.eql(400);",
							"    var contactResp = jsonData.compositeResponse.find(r => r.referenceId === \"RollbackContactRef\");",
							"    pm.expect(contactResp.httpStatusCode).to.eql(400);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"allOrNone\": true,\n    \"compositeRequest\": [\n        {\n            \"method\": \"POST\",\n            \"url\": \"/services/data/v68.0/sobjects/Contact\",\n            \"referenceId\": \"RollbackContactRef\",\n            \"body\": {\n                \"FirstName\": \"Rollback\",\n                \"LastName\": \"Candidate {{$timestamp}}\",\n                \"Email\": \"rollback.candidate.{{$timestamp}}@sparknestenergy.com\",\n                \"Phone\": \"9111122223\"\n            }\n        },\n        {\n            \"method\": \"POST\",\n            \"url\": \"/services/data/v68.0/sobjects/Enquiry__c\",\n            \"referenceId\": \"RollbackEnquiryRef\",\n            \"body\": {\n                \"Subject__c\": \"Invalid Budget Test Enquiry\",\n                \"Contact__c\": \"@{RollbackContactRef.id}\",\n                \"Enquiry_Type__c\": \"Product Enquiry\",\n                \"Source__c\": \"Web\",\n                \"Customer_Budget__c\": 500\n            }\n        }\n    ]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{instance_url}}/services/data/v68.0/composite",
					"host": [
						"{{instance_url}}"
					],
					"path": [
						"services",
						"data",
						"v68.0",
						"composite"
					]
				}
			},
			"response": []
		},
